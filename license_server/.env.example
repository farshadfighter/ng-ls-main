# ---------------------------------------------------------------------------
# Only needed when running the license server DIRECTLY on a host, outside
# docker (uvicorn app.main:app --port 8001).
#
# Under docker compose these values come from the ROOT .env via
# docker-compose.yml — this file is .dockerignore'd and is NOT read inside the
# container. Configure the stack there, not here.
# ---------------------------------------------------------------------------

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Security - CHANGE THESE IN PRODUCTION!
# Generate with: openssl rand -hex 32
# REQUIRED: the app refuses to start without it (no default).
SECRET_KEY=your-secret-key-here-change-in-production-use-cryptographically-secure-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_EXPIRE_HOURS=24

# Redis Configuration
# Under docker compose this is the service name `redis`, not localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave blank for a local dev Redis with no requirepass set. Under docker
# compose this is REQUIRED (see root .env.example) — the redis service there
# refuses unauthenticated connections.
REDIS_PASSWORD=

# Rate Limiting (requests per minute, per client IP)
RATE_LIMIT_PER_MINUTE=60

# API Configuration
API_V1_PREFIX=/api

# Admin Credentials - CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Cloudflare Turnstile secret for the admin login form.
# REQUIRED: admin logins are rejected while it is unset.
TURNSTILE_SECRET_KEY=

# CORS — comma-separated origins (scheme + host[:port], no wildcard) allowed to
# make credentialed cross-origin requests. Only needed when the built admin UI
# is hosted separately from this API (VITE_LICENSE_API_URL points elsewhere);
# when nginx serves both from the same origin (the normal setup) this is
# irrelevant, since the browser sees those calls as same-origin. Empty = no
# cross-origin caller trusted.
# e.g. CORS_ALLOWED_ORIGINS=https://172.16.120.81,https://license.ngcorion.local
CORS_ALLOWED_ORIGINS=
