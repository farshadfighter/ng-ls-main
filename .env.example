# ---------------------------------------------------------------------------
# Compose configuration for the standalone License Server stack.
#
#   cp .env.example .env   &&   edit   &&   docker compose up -d --build
#
# This file is the single source of configuration for the stack. The backend
# container gets these values as real environment variables from
# docker-compose.yml — it no longer relies on a .env file baked into the image.
# ---------------------------------------------------------------------------

# --- Secrets (REQUIRED — compose refuses to start without them) -------------
# Sign the admin console's session tokens. At least 32 characters; generate
# with:  openssl rand -hex 32
SECRET_KEY=

# The FIRST admin account, made at the first start. Its owner must change the
# password at first login; after that these two are not read. Everyone who
# uses the console gets an account of their own (Users page), so the audit
# trail names who did what. At least 12 characters with three of: lower case,
# upper case, digits, symbols; not containing the user name.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudflare Turnstile — the bot check on the admin console's login.
#
# TURNSTILE_ENABLED=true (the default, and the only setting for an
# internet-reachable server) requires the challenge, and TURNSTILE_SECRET_KEY is
# then REQUIRED: the secret paired with the site key the login form uses. While
# it is empty every login is refused with 503.
#
# Set TURNSTILE_ENABLED=false only where this host cannot reach Cloudflare (an
# air-gapped install, a lab). The challenge is then skipped and the widget
# disappears from the login form; the account password, lockout and sessions are
# the only gate on the console. The form reads the flag at runtime
# (GET /api/admin/login-options): `docker compose restart backend`, no rebuild.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# Ed25519 key that signs every licensing answer (base64 of the 32-byte seed).
# Generate once with:  python license_server/scripts/generate_signing_key.py
# It also prints the PUBLIC key, which goes into NGCorion's
# app/core/license_keys.py. Keep this private key here only: never commit it,
# never copy it to another machine - whoever has it can mint licenses.
LICENSE_SIGNING_PRIVATE_KEY=

# Redis auth. Redis sits on the internal compose network with no published
# port, but any other container joined to app-network could otherwise reach it
# unauthenticated. Generate with:  openssl rand -hex 32
REDIS_PASSWORD=

# --- Postgres ---------------------------------------------------------------
# Not published to the host; reachable only on the internal compose network.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# --- Ports published on the host --------------------------------------------
# Plain HTTP, and the primary entry point: the domain manager terminates TLS
# for the public name and forwards cleartext here, so this port serves the whole
# application (admin UI, /api, /internal, /health). It no longer redirects.
FRONTEND_PORT=80
# HTTPS, for direct local/internal access by IP that bypasses the domain
# manager. Serves exactly the same application as port 80. A client on this
# network can still point LICENSE_SERVER_URL at https://<this-host>:${HTTPS_PORT}
# and trust the self-signed cert via LICENSE_SERVER_CA_BUNDLE.
# The API container's own 8001 is not published to the host — nginx reaches it
# over the internal compose network.
HTTPS_PORT=443

# --- TLS certificate ---------------------------------------------------------
# This host is internal and is reached by IP, so no public CA / Let's Encrypt
# certificate is possible: ./scripts/gen-self-signed-cert.sh issues a
# self-signed one into ./certs (gitignored) and nginx serves it on ${HTTPS_PORT}.
#
# The address below goes into the certificate's Subject Alternative Name. It
# MUST be the address clients actually connect to, or their TLS verification
# fails — which is the point: the fix is a correct SAN, never a client that
# skips verification.
#
# LICENSE_SERVER_IP is also what the nginx healthcheck verifies the cert
# against (docker-compose.yml), so it must match the cert that is mounted.
LICENSE_SERVER_IP=172.16.120.81
# Every hostname the server is reached by, comma-separated. Each becomes a DNS
# SAN. Adding a domain here (and re-issuing the cert) is all a new domain needs:
# nginx serves every Host from the same HTTPS block, so the IP keeps working.
LICENSE_SERVER_DNS=license.ngcorion.local,lic.ngcorion.com

# --- Let's Encrypt for lic.ngcorion.com (optional, see ACME.md) --------------
# Only read with the override file docker-compose.acme.yml. To use it, either
# run  docker compose -f docker-compose.yml -f docker-compose.acme.yml up -d
# or uncomment COMPOSE_FILE so a plain `docker compose up -d` includes it.
# Traefik then serves lic.ngcorion.com on HTTPS_PORT with a Let's Encrypt
# certificate it renews by itself; the IP and every other name keep the
# self-signed certificate above.
#COMPOSE_FILE=docker-compose.yml:docker-compose.acme.yml
# Required with the override: Let's Encrypt's address for expiry notices.
ACME_EMAIL=
# Production CA by default. For a trial run, the staging CA (certificates no
# client trusts, but no risk of hitting the weekly limit):
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Port 80 -> HTTPS for lic.ngcorion.com (on|off). Leave it off: run
# scripts/enable-https-redirect.sh once the certificate works, which checks it
# and sets this to on. The IP, other names, /internal/ and /health never redirect.
HTTPS_REDIRECT=off

# --- CORS ---------------------------------------------------------------
# Comma-separated origins (scheme + host[:port], no wildcard) allowed to make
# credentialed cross-origin requests to the API. nginx serves the admin UI and
# proxies /api/ to the backend on the SAME origin (LICENSE_SERVER_IP /
# LICENSE_SERVER_DNS on HTTPS_PORT), so the browser treats those calls as
# same-origin and this is irrelevant for that setup. It only matters if the
# built admin UI is ever pointed at a separately hosted API (see
# license-admin-ui/.env.example's VITE_LICENSE_API_URL) — list that UI's
# origin(s) here. Left empty (no cross-origin caller trusted) unless you need it.
CORS_ALLOWED_ORIGINS=

# --- Internal portal integration --------------------------------------------
# The License Server exposes /internal/portal/* for the internal portal at
# PORTAL_BASE_URL to create licenses from orders. Reached over the same HTTPS
# listener as everything else, restricted to PORTAL_IP_WHITELIST by nginx
# (`allow`/`deny` in license-admin-ui/nginx.conf) and again by the app.
#
# Shared HS256 secret the portal signs its 5-minute service tokens with, and
# this server verifies them against. MUST be different from SECRET_KEY above:
# that one signs admin UI sessions, and one key for both would let a leaked
# portal secret mint admin tokens. Generate with:  openssl rand -hex 32
# Required — unset means every /internal/portal/* call is refused with 503.
PORTAL_JWT_SECRET=

# Where the portal lives. License events are POSTed to
# ${PORTAL_BASE_URL}/internal/ls/license-events; phase 4 will read the
# users/orders endpoints from the same base.
#
# Set this to empty to turn OUTBOUND notification off while keeping the inbound
# endpoints working — useful when the portal is not up yet. The inbound
# endpoints do not read it.
PORTAL_BASE_URL=http://172.16.120.80

# Outbound license events are fire-and-forget: a background queue, up to
# PORTAL_EVENT_MAX_ATTEMPTS tries with exponential backoff, and failures are
# logged and dropped — never raised to the caller. The defaults below are in
# app/core/config.py and only need setting to override them:
#
#   PORTAL_EVENT_MAX_ATTEMPTS=3        total tries (1 POST + 2 retries)
#   PORTAL_EVENT_BACKOFF_BASE_SECONDS=1.0
#   PORTAL_EVENT_TIMEOUT_SECONDS=5.0   per-request timeout
#   PORTAL_EVENT_WORKERS=2             queue-draining threads
#   PORTAL_EVENT_QUEUE_MAXSIZE=1000    beyond this, events are dropped
#   PORTAL_EVENT_JWT_ISSUER=license-server   our tokens' iss (reverse of inbound)
#   PORTAL_EVENT_JWT_AUDIENCE=portal         our tokens' aud
#
# How often to look for licenses that expired since the last pass, and emit
# license.expired for them. Nothing else in this codebase reacts to expiry —
# expires_at is only checked when a client calls validate/activate — so without
# this sweep a customer who stops using the software expires silently and the
# portal is never told. Set to 0 to disable it.
#   PORTAL_EXPIRY_SWEEP_INTERVAL_SECONDS=300
#
# The portal's users and orders are pulled into local cache tables
# (portal_users_cache / portal_orders_cache) so the admin UI's manual license
# form can link a license to a portal user and order. Defaults in
# app/core/config.py; set only to override:
#
#   PORTAL_SYNC_INTERVAL_SECONDS=900   every 15 min; 0 = manual sync only
#   PORTAL_SYNC_PAGE_SIZE=50           `per_page` sent to the portal
#   PORTAL_SYNC_MAX_PAGES=200          guard rail, not a data limit
#   PORTAL_SYNC_TIMEOUT_SECONDS=15.0
#
# An admin can always sync on demand with POST /api/admin/portal/sync.

# Comma-separated IPs or CIDR blocks allowed to call /internal/portal/*.
# Empty means nobody, which is the safe default.
#
# Changing this is a TWO-file edit: the `allow` line in
# license-admin-ui/nginx.conf is the primary gate and is not templated from
# here (nginx.conf is bind-mounted verbatim, with no envsubst step).
PORTAL_IP_WHITELIST=172.16.120.80

# --- Admin sessions and logins -------------------------------------------
# A session ends after this many minutes without use, and this many hours
# after login at the latest.
ADMIN_IDLE_TIMEOUT_MINUTES=15
JWT_EXPIRE_HOURS=8
# After this many failed logins in a row an account is locked for
# ADMIN_LOCKOUT_MINUTES (an admin can unlock it sooner on the Users page).
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# --- Tuning -----------------------------------------------------------------
# Requests per minute per client IP, enforced by the Redis-backed limiter.
RATE_LIMIT_PER_MINUTE=60
